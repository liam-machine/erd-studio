{
  "name": "erd-studio-getting-started-video",
  "private": true,
  "description": "Source and render pipeline for the getting-started videos (media/onboarding/getting-started.mp4, a recording of the real VS Code; getting-started-logical.mp4) and the README GIF (media/demo.gif). Not part of the extension build.",
  "type": "module",
  "scripts": {
    "tts": "uv run tts.py",
    "tts:say": "uv run tts.py --engine say",
    "timeline": "node build-timeline.mjs",
    "record:setup": "node record/vscode.mjs setup",
    "fixtures": "node record/fixtures.mjs",
    "record": "node record/record.mjs",
    "preview": "node serve.mjs",
    "capture": "node capture.mjs",
    "capture:draft": "node capture.mjs --draft",
    "composite": "node record/composite.mjs",
    "still": "node record/composite.mjs --stills",
    "encode": "bash encode.sh",
    "qa": "bash qa.sh",
    "thumbnail": "node thumbnail.mjs",
    "test": "node --test test/pipeline.test.mjs",
    "all": "npm run tts && npm run timeline && npm run capture && npm run composite && npm run encode",
    "all:logical": "VARIANT=logical npm run all",
    "qa:logical": "VARIANT=logical npm run qa",
    "preview:logical": "echo 'open http://127.0.0.1:4173/video/player/index.html?variant=logical&preview=1' && node serve.mjs",
    "gif": "node hero-gif.mjs",
    "confluence": "node confluence-shot.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "yaml": "2.9.0"
  },
  "engines": {
    "node": ">=18"
  }
}

{
  "name": "@erd-studio/core",
  "version": "0.4.0",
  "description": "ERD Studio domain model: types and the pure raw-files -> DisplaySubjectArea pipeline.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/liam-machine/erd-studio",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@dbml/parse": "10.3.1",
    "@types/node": "^20.17.0",
    "dbml-core-v2": "npm:@dbml/core@2.6.1",
    "dbml-core-v24": "npm:@dbml/core@2.4.2",
    "dbml-core-v3": "npm:@dbml/core@3.13.4",
    "dbml-parse-v11": "npm:@dbml/parse@11.0.0",
    "dbml-parse-v9": "npm:@dbml/parse@9.1.1",
    "esbuild": "^0.24.0",
    "jsdom": "25.0.1",
    "mermaid": "10.0.0",
    "mermaid-current": "npm:mermaid@12.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

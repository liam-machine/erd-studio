Table fct_large_table [
  schema: 'silver',
  role: 'transaction-fact',
  grain: 'One row per transaction event'
] {
  transaction_id INT [pk, note: 'Transaction id from the source system — a degenerate dimension, and this fact\'s own key', natural_key: 'true']
  event_date DATE [note: 'Date of the event']
  warehouse_key INT [note: 'Originating warehouse']
  customer_key INT [note: 'FK to dim_customer', foreign_key: 'true']
  delivery_date DATE [note: 'Date order was delivered']
  project_key INT [note: 'FK to dim_project', foreign_key: 'true']
  product_key INT [note: 'FK to dim_product', foreign_key: 'true']
  channel_key INT [note: 'FK to dim_channel', foreign_key: 'true']
  region_code VARCHAR [note: 'Geographic region code']
  country_code VARCHAR [note: 'ISO country code']
  city_name VARCHAR [note: 'City of the transaction']
  postal_code VARCHAR [note: 'Postal or ZIP code']
  transaction_type VARCHAR [note: 'Type of transaction (sale, return, exchange)']
  is_refunded BOOLEAN [note: 'Whether the transaction was refunded']
  payment_method VARCHAR [note: 'Payment method used']
  currency_code VARCHAR [note: 'ISO currency code']
  gross_amount "DECIMAL(18,2)" [note: 'Gross transaction amount before tax']
  tax_amount "DECIMAL(18,2)" [note: 'Tax component']
  discount_amount "DECIMAL(18,2)" [note: 'Discount applied']
  net_amount "DECIMAL(18,2)" [note: 'Net amount after tax and discount']
  unit_price "DECIMAL(18,2)" [note: 'Price per unit']
  cost_price "DECIMAL(18,2)" [note: 'Cost price per unit']
  margin_amount "DECIMAL(18,2)" [note: 'Profit margin amount']
  margin_pct "DECIMAL(5,2)" [note: 'Profit margin percentage']
  quantity INT [note: 'Number of units']
  refund_date DATE [note: 'Date of refund if applicable']
  shipping_cost "DECIMAL(18,2)" [note: 'Cost of shipping']
  shipping_method VARCHAR [note: 'Shipping carrier and method']
  order_status VARCHAR [note: 'Current status of the order']
  fulfillment_date DATE [note: 'Date order was fulfilled']
  sales_rep_id INT [note: 'Assigned sales representative']
  campaign_id INT [note: 'Marketing campaign attribution']
  source_system VARCHAR [note: 'Originating source system']
  event_timestamp TIMESTAMP [note: 'Exact time of the event']
  batch_id INT [note: 'ETL batch identifier']
  loaded_at TIMESTAMP [note: 'When the row was loaded']
  Note: 'Fact table with many columns to test drag-reorder auto-scroll'
}

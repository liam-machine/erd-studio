// Kept from silver/scroll-test.json by Convert Project to DBML:
// "logical.viewConfig": {}
Project "scroll-test" {
  Note: 'Test domain — model with many columns for drag-reorder scroll testing'
  erd_schema_version: '7'
  erd_model_folder: 'models/silver'
}

use { table fct_large_table } from '../tables/fct_large_table.dbml'
use * from '../tables/_relationships.dbml'

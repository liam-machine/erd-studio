Table silver.dim_task [
  role: 'domain-dim',
  grain: 'One row per task version',
  purpose: 'Tracks individual tasks and their lifecycle',
  design: 'SCD Type 2 on status to track historical state changes',
  scd_strategy: 'task_key is unique per row; task_id repeats across the versions of one task, which is why it cannot be the primary key'
] {
  Note: 'Task dimension tracking individual project tasks'

  task_key    INT     [
    pk,
    scd_type: '0',
    note: 'Surrogate key — one per row, so one per version of the task'
  ]
  task_id     VARCHAR [
    natural_key: 'true',
    scd_type: '0',
    note: 'Business key — repeats across the versions of one task'
  ]
  project_key INT     [foreign_key: 'true', note: 'FK to dim_project']
  name        VARCHAR [scd_type: '1', note: 'Task name']
  status      STRING  [scd_type: '2', note: 'Current lifecycle status']
}

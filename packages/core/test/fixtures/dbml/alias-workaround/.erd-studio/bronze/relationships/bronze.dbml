// ERD Studio relationships: Refs only, split across relationships/ files however you like. Every table a Ref names has a use line here.
use { table bqs.addresse }     from '../tables/bqs/addresse.dbml'
use { table bqs.kunde }        from '../tables/bqs/kunde.dbml'
use { table ccc.ccc_addresse } from '../tables/ccc/ccc_addresse.dbml'
use { table ccc.ccc_kunde }    from '../tables/ccc/ccc_kunde.dbml'

Ref: bqs.kunde.addresse_id >? bqs.addresse.id
Ref: ccc.ccc_kunde.addresse_id >? ccc.ccc_addresse.id
Ref: ccc.ccc_addresse.id >? bqs.addresse.id

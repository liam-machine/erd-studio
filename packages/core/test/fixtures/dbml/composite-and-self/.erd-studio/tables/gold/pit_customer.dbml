// Kept from logical-models/gold/pit_customer.yml by Convert Project to DBML:
// # A Data Vault point-in-time table: one composite foreign key to the
// # satellite, and an entry whose compositeKey has no partner (drawn single).
Table pit_customer {
  pit_customer_hk binary [pk]
  customer_hk binary
  as_of_date date
  snapshot_hk binary
}

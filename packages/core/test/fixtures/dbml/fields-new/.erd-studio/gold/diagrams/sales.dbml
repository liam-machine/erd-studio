use { table gold.fct_sale }   from '../tables/gold/fct_sale.dbml'
use { table gold.dim_store }  from '../tables/gold/dim_store.dbml'
use { table gold.fct_return } from '../tables/gold/fct_return.dbml'
use * from '../relationships/gold.dbml'

Project sales {
  Note: 'Sales by store, in the 2.0 spellings'
  erd_schema_version: '7'
  erd_layout: '''
    dim_store 40 60
    fct_return 500 400
    fct_sale 500 60
  '''
}

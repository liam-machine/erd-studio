{
  "schemaVersion": 5,
  "domain": "ledger",
  "layer": "silver",
  "description": "Rationale and meta as model files held them before context fields",
  "logical": {
    "models": [
      "dim_account",
      "fct_balance"
    ],
    "relationships": [

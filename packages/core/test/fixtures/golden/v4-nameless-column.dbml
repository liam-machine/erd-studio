// stg_orders: column 1 has no name; not exported
Table stg_orders {
  "123" INT [note: 'A column named by a number']
  order_id BIGINT [pk]
  customer_key INT
}

// stg_customers: column 1 has no name; not exported
Table stg_customers {
  Customer_Key INT [pk]
}

Ref: stg_orders.customer_key > stg_customers.Customer_Key

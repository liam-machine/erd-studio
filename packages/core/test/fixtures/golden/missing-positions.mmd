%% erd-studio mermaid-export v1
%% Not exported: canvas positions and sizes, sticky-note colours, nested meta values (lists and maps).
%% Types and column names keep only letters, digits and _; a column comment gives the original when it differs.
%% Diagram: showcase (layer silver, logical stage)
%% Description: Project task management — tracks projects, tasks, events, and customers

  %% Model fct_task_event
  %%   schema: silver
  %%   role: transaction-fact
  %%   grain: One row per task event
  %%   description: Records every task event across all projects and tasks
  %%   Purpose: Central fact table tracking all task activity for reporting and analysis
  %%   Design: Transaction grain with surrogate foreign keys to all relevant dimensions
  %%   Measures: duration_hours (additive), amount (additive)
  "fct_task_event" {
    INT event_id PK, UK "Event id from the source system — a degenerate dimension, and this fact's own key"
    INT task_key FK "FK to dim_task"
    INT project_key FK "FK to dim_project"
    INT customer_key FK "FK to dim_customer"
    DATE event_date "Date the event occurred"
    VARCHAR event_type "Type of task event (started, completed, blocked)"
    DECIMAL amount "Cost or value of the event; additive"
    DECIMAL duration_hours "Hours spent on this event; additive"
  }

  %% Model dim_task
  %%   schema: silver
  %%   role: domain-dim
  %%   grain: One row per task version
  %%   description: Task dimension tracking individual project tasks
  %%   Purpose: Tracks individual tasks and their lifecycle
  %%   Design: SCD Type 2 on status to track historical state changes
  %%   SCD strategy: task_key is unique per row; task_id repeats across the versions of one task, which is why it cannot be the primary key
  "dim_task" {
    INT task_key PK "Surrogate key — one per row, so one per version of the task; SCD type 0"
    VARCHAR task_id UK "Business key — repeats across the versions of one task; SCD type 0"
    INT project_key FK "FK to dim_project"
    VARCHAR name "Task name; SCD type 1"
    STRING status "Current lifecycle status; SCD type 2"
  }

  %% Model dim_project
  %%   schema: silver
  %%   role: conformed-dim
  %%   grain: One row per project
  %%   description: Project dimension table
  %%   Purpose: Central project reference shared across domains
  %%   Design: Conformed dimension for consistent project attributes
  %%   SCD strategy: project_key is the surrogate facts join to; project_code is the business key
  "dim_project" {
    INT project_key PK "Surrogate key — warehouse-generated, one per row; SCD type 0"
    VARCHAR project_code UK "Business project code from the source system; SCD type 0"
    VARCHAR project_name "Project name — not unique, so never a key; SCD type 1"
    INT parent_project_key FK "Parent project for hierarchical rollups (self-reference to project_key)"
  }

  %% Model dim_customer
  %%   schema: silver
  %%   role: conformed-dim
  %%   grain: One row per customer
  %%   description: Customer dimension with demographics and segmentation
  %%   Purpose: Central customer reference shared across domains
  %%   Design: Conformed dimension for consistent customer attributes
  %%   SCD strategy: customer_key is the surrogate facts join to; customer_id is the source system's business key
  "dim_customer" {
    INT customer_key PK "Surrogate key — warehouse-generated, one per row; SCD type 0"
    VARCHAR customer_id UK "Business key from the source CRM; SCD type 0"
    VARCHAR customer_name "Full customer name — not unique, so never a key; SCD type 2"
    VARCHAR email "Customer email address; SCD type 1"
  }

  %% Model dim_date
  %%   schema: silver
  %%   role: conformed-dim
  %%   grain: One row per calendar date
  %%   description: Date dimension with fiscal calendar attributes
  %%   Purpose: Shared date reference for consistent time-based analysis
  %%   Design: The one dimension where a meaningful key is conventional — date_key is YYYYMMDD rather than a meaningless sequence
  "dim_date" {
    INT date_key PK "Date key in YYYYMMDD form — meaningful by convention, unlike every other surrogate"
    DATE calendar_date UK "The calendar date — the business key this dimension is identified by"
    INT fiscal_year "Fiscal year number"
    VARCHAR fiscal_quarter "Fiscal quarter (Q1-Q4)"
  }

  %% Model fct_order
  %%   description: Order transaction fact table
  "fct_order" {
    INT order_id PK, UK "Order id from the source system — a degenerate dimension, and this fact's own key"
    INT customer_key FK "FK to dim_customer"
    DATE order_date "Date the order was placed"
    INT project_key FK "FK to dim_project"
    DECIMAL amount "Order total amount; additive"
  }

  %% fct_task_event.task_key -> dim_task.task_key, many-to-one
  "fct_task_event" }o--|| "dim_task" : "task_key"
  %% dim_task.project_key -> dim_project.project_key, many-to-one
  "dim_task" }o--|| "dim_project" : "project_key"
  %% fct_task_event.project_key -> dim_project.project_key, many-to-one
  "fct_task_event" }o--|| "dim_project" : "project_key"
  %% dim_project.parent_project_key -> dim_project.project_key, many-to-one
  "dim_project" }o--|| "dim_project" : "parent_project_key"
  %% fct_order.project_key -> dim_project.project_key, many-to-one
  "fct_order" }o--|| "dim_project" : "project_key"
  %% fct_task_event.customer_key -> dim_customer.customer_key, many-to-one
  "fct_task_event" }o--|| "dim_customer" : "customer_key"
  %% fct_order.customer_key -> dim_customer.customer_key, many-to-one
  "fct_order" }o--|| "dim_customer" : "customer_key"

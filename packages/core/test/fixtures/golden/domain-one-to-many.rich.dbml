// erd-studio dbml-export v2 (DBML 9.1+)
// Table positions: sales.dbdiagram, next to this file (`dbdiagram push` reads it).
// A ? beside a Ref operator marks the end across from it as possibly null: ERD Studio does not record nullability, so only primary-key columns are NOT NULL.
// Not exported: sticky-note positions and sizes, the canvas layout options.

Project sales {
  Note: 'ERD Studio 1.6.6 / 1.6.7 saved a line drawn from the dimension as one-to-many in the domain file (#163)'
}

Table gold.fct_sale {
  sale_id BIGINT [pk]
  store_key INT
  amount "DECIMAL(18,2)"
  Note: 'One row per sale'
}

Table gold.dim_store {
  store_key INT [pk]
  store_name VARCHAR
  Note: 'One row per store'
}

TableGroup gold [color: #d4a017, note: 'Layer: Gold'] {
  gold.fct_sale
  gold.dim_store
}

Ref: gold.fct_sale.store_key >? gold.dim_store.store_key

    VARCHAR ort
  }

  %% Table kunde
  %%   schema: bqs
  %%   description: Customers from the BQS system
  "kunde" {
    INT id PK
    VARCHAR name
    INT addresse_id FK
  }

  %% Table ccc_addresse
  %%   schema: ccc
  %%   alias: addresse
  %%   description: Addresses from the CCC system
  "ccc_addresse" {
    INT id PK, FK
    VARCHAR street
    VARCHAR city
    VARCHAR postcode
  }

  %% Table ccc_kunde
  %%   schema: ccc
  %%   alias: kunde
  %%   description: Customers from the CCC system
  "ccc_kunde" {
    INT id PK
    VARCHAR full_name
    INT addresse_id FK
  }


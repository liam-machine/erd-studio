  %%   role: fact
  %%   grain: One row per order line
  %%   description: Orders as they land from the shop API
  %%   Purpose: Keeps the shop feed untouched for replay
  %%   Measures: line_amount is additive
  "raw_orders" {
    BIGINT order_line_id PK "Line identifier from the shop"
    VARCHAR customer_ref FK "Customer reference, joined without a declared key"
    unknown shop_payload
    DECIMAL_12_2 line_amount "Line total; type DECIMAL(12,2); additive"
    VARCHAR order_number UK "Business order number"
  }


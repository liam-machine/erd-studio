// erd-studio dbml-export v1
// Not exported: canvas positions and sizes, sticky-note colours, nested meta values (lists and maps).
// ERD Studio's own fields (role, grain, alias, rationale, natural keys, SCD type, additivity, meta) are in the notes.

Project kunden {
  Note: '''Layer: bronze
Stage: logical

Customers and addresses from both source systems'''
}

Table bqs.addresse {
  id INT [pk]
  strasse VARCHAR
  ort VARCHAR
  Note: 'Addresses from the BQS system'
}

Table bqs.kunde {
  id INT [pk]
  name VARCHAR
  addresse_id INT
  Note: 'Customers from the BQS system'
}

Table ccc.addresse {
  id INT [pk]
  street VARCHAR
  city VARCHAR
  postcode VARCHAR
  Note: 'Addresses from the CCC system'
}

Table ccc.kunde {
  id INT [pk]
  full_name VARCHAR
  addresse_id INT
  Note: 'Customers from the CCC system'
}

Ref: bqs.kunde.addresse_id > bqs.addresse.id
Ref: ccc.addresse.id > bqs.addresse.id
Ref: ccc.kunde.addresse_id > ccc.addresse.id

// Sticky note 1 (linked to ccc.addresse): The CCC addresses are matched to BQS by id

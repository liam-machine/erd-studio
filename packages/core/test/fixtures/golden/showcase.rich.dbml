// erd-studio dbml-export v2 (DBML 9.1+)
// A ? beside a Ref operator marks the end across from it as possibly null: ERD Studio does not record nullability, so only primary-key columns are NOT NULL.
// Not exported: the canvas layout options.

Project showcase {
  Note: 'Project task management — tracks projects, tasks, events, and customers'
  erd_layout: '''
    dim_customer 40 60
    dim_date 40 520
    dim_project 980 60
    dim_task 1026 586
    fct_order 500 250
    fct_task_event 438 544
  '''
}

Table silver.fct_task_event [
  role: 'transaction-fact',
  grain: 'One row per task event',
  rationale_purpose: 'Central fact table tracking all task activity for reporting and analysis',
  rationale_design: 'Transaction grain with surrogate foreign keys to all relevant dimensions',
  rationale_measures: 'duration_hours (additive), amount (additive)'
] {
  event_id INT [pk, note: 'Event id from the source system — a degenerate dimension, and this fact\'s own key', natural_key: 'true']
  task_key INT [note: 'FK to dim_task', foreign_key: 'true']
  project_key INT [note: 'FK to dim_project', foreign_key: 'true']
  customer_key INT [note: 'FK to dim_customer', foreign_key: 'true']
  event_date DATE [note: 'Date the event occurred']
  event_type VARCHAR [note: 'Type of task event (started, completed, blocked)']
  amount DECIMAL [note: 'Cost or value of the event', additive_type: 'additive']
  duration_hours DECIMAL [note: 'Hours spent on this event', additive_type: 'additive']
  Note: 'Records every task event across all projects and tasks'
}

Table silver.dim_task [
  role: 'domain-dim',
  grain: 'One row per task version',
  rationale_purpose: 'Tracks individual tasks and their lifecycle',
  rationale_design: 'SCD Type 2 on status to track historical state changes',
  rationale_scd_strategy: 'task_key is unique per row; task_id repeats across the versions of one task, which is why it cannot be the primary key'
] {
  task_key INT [pk, note: 'Surrogate key — one per row, so one per version of the task', scd_type: '0']
  task_id VARCHAR [note: 'Business key — repeats across the versions of one task', natural_key: 'true', scd_type: '0']
  project_key INT [note: 'FK to dim_project', foreign_key: 'true']
  name VARCHAR [note: 'Task name', scd_type: '1']
  status STRING [note: 'Current lifecycle status', scd_type: '2']
  Note: 'Task dimension tracking individual project tasks'
}

Table silver.dim_project [
  role: 'conformed-dim',
  grain: 'One row per project',
  rationale_purpose: 'Central project reference shared across domains',
  rationale_design: 'Conformed dimension for consistent project attributes',
  rationale_scd_strategy: 'project_key is the surrogate facts join to; project_code is the business key'
] {
  project_key INT [pk, note: 'Surrogate key — warehouse-generated, one per row', scd_type: '0']
  project_code VARCHAR [note: 'Business project code from the source system', natural_key: 'true', scd_type: '0']
  project_name VARCHAR [note: 'Project name — not unique, so never a key', scd_type: '1']
  parent_project_key INT [note: 'Parent project for hierarchical rollups (self-reference to project_key)', foreign_key: 'true']
  Note: 'Project dimension table'
}

Table silver.dim_customer [
  role: 'conformed-dim',
  grain: 'One row per customer',
  rationale_purpose: 'Central customer reference shared across domains',
  rationale_design: 'Conformed dimension for consistent customer attributes',
  rationale_scd_strategy: 'customer_key is the surrogate facts join to; customer_id is the source system\'s business key'
] {
  customer_key INT [pk, note: 'Surrogate key — warehouse-generated, one per row', scd_type: '0']
  customer_id VARCHAR [note: 'Business key from the source CRM', natural_key: 'true', scd_type: '0']
  customer_name VARCHAR [note: 'Full customer name — not unique, so never a key', scd_type: '2']
  email VARCHAR [note: 'Customer email address', scd_type: '1']
  Note: 'Customer dimension with demographics and segmentation'
}

Table silver.dim_date [
  role: 'conformed-dim',
  grain: 'One row per calendar date',
  rationale_purpose: 'Shared date reference for consistent time-based analysis',
  rationale_design: 'The one dimension where a meaningful key is conventional — date_key is YYYYMMDD rather than a meaningless sequence'
] {
  date_key INT [pk, note: 'Date key in YYYYMMDD form — meaningful by convention, unlike every other surrogate']
  calendar_date DATE [note: 'The calendar date — the business key this dimension is identified by', natural_key: 'true']
  fiscal_year INT [note: 'Fiscal year number']
  fiscal_quarter VARCHAR [note: 'Fiscal quarter (Q1-Q4)']
  Note: 'Date dimension with fiscal calendar attributes'
}

Table fct_order {
  order_id INT [pk, note: 'Order id from the source system — a degenerate dimension, and this fact\'s own key', natural_key: 'true']
  customer_key INT [note: 'FK to dim_customer', foreign_key: 'true']
  order_date DATE [note: 'Date the order was placed']
  project_key INT [note: 'FK to dim_project', foreign_key: 'true']
  amount DECIMAL [note: 'Order total amount', additive_type: 'additive']
  Note: 'Order transaction fact table'
}

TableGroup silver [color: #a0a0a0, note: 'Layer: Silver'] {
  silver.fct_task_event
  silver.dim_task
  silver.dim_project
  silver.dim_customer
  silver.dim_date
  fct_order
}

Ref: silver.fct_task_event.task_key >? silver.dim_task.task_key
Ref: silver.dim_task.project_key >? silver.dim_project.project_key
Ref: silver.fct_task_event.project_key >? silver.dim_project.project_key
Ref: silver.dim_project.parent_project_key >? silver.dim_project.project_key
Ref: fct_order.project_key >? silver.dim_project.project_key
Ref: silver.fct_task_event.customer_key >? silver.dim_customer.customer_key
Ref: fct_order.customer_key >? silver.dim_customer.customer_key

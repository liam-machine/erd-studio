// erd-studio dbml-export v2 (DBML 9.1+)
// Table positions: accounts.dbdiagram, next to this file (`dbdiagram push` reads it).
// A ? beside a Ref operator marks the end across from it as possibly null: ERD Studio does not record nullability, so only primary-key columns are NOT NULL.
// Not exported: sticky-note positions and sizes, the canvas layout options.

Project accounts {
}

Table fct_txn [role: 'fact'] {
  txn_id BIGINT [pk, note: 'Transaction id']
  account_key INT [note: 'Account', foreign_key: 'true']
  amount "DECIMAL(18,2)" [note: 'Signed amount', additive_type: 'additive']
  balance_after "DECIMAL(18,2)" [note: 'Running balance', additive_type: 'semi-additive']
  Note: 'Transactions'
}

Table "007".dim_account [
  role: 'dimension',
  grain: 'One row per account',
  rationale_purpose: 'Shared account reference',
  rationale_design: 'Shared account reference',
  rationale_role_choice: 'Type 2 dimension'
] {
  account_key INT [pk, note: 'Surrogate key', scd_type: '0']
  account_number "VARCHAR(20)" [note: 'Business key', natural_key: 'true', scd_type: '1']
  opened_on DATE [scd_type: '2']
  balance "12.50" [note: '1e3']
  Note: 'Accounts, one row per account'
}

// Not exported: fct_txn is listed more than once; exported once.

TableGroup gold [color: #d4a800, note: 'Layer: Gold'] {
  fct_txn
  "007".dim_account
}

Ref: fct_txn.account_key >? "007".dim_account.account_key

Note sticky_1 [color: #3b82f6, linked_table: 'dim_account'] {
  'Linked note'
}

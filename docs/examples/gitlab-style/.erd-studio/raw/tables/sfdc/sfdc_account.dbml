// Salesforce and Zuora both land a table called account. This example puts the source in the
// name and the warehouse name in alias, so every name is unique.
Table sfdc.sfdc_account [alias: 'account'] {
  Note: 'Salesforce accounts, as extracted.'

  id           STRING [pk, note: 'Salesforce account id']
  name         STRING
  type         STRING
  ownerid      STRING
  isdeleted    BOOLEAN
  _uploaded_at TIMESTAMP
}

use { table staging.stg_app__accounts } from '../tables/staging/stg_app__accounts.dbml'
use { table staging.stg_app__users }    from '../tables/staging/stg_app__users.dbml'
use * from '../relationships/staging.dbml'

Project app {
  Note: 'Staging models for the product database (models/staging/app/).'
  erd_schema_version: '7'
  erd_layout: '''
    stg_app__accounts 432 12
    stg_app__users 12 12
  '''
}

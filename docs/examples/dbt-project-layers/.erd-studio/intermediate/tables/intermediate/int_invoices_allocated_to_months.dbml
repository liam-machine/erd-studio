// int_<entity>s_<verb>s: what the model does to its input.
Table intermediate.int_invoices_allocated_to_months [
  grain: 'One row per invoice per month it covers',
  decisions: 'Spreads each invoice over the months of its period, so monthly revenue can be summed.'
] {
  Note: 'Invoices spread over the months they pay for.'

  invoice_id       STRING          [foreign_key: 'true']
  revenue_month    DATE
  customer_id      STRING
  allocated_amount "DECIMAL(12,2)" [additive_type: 'additive']
  indexes {
    (invoice_id, revenue_month) [pk]
  }
}

Table atlas.clients_daily [
  grain: 'One row per client per day',
  rationale_design: 'A view of atlas_derived.clients_daily_v6. Queries use the view, so the next version of the table can replace this one behind it.',
  meta_materialized: 'view'
] {
  Note: 'Each client\'s activity on each day.'

  submission_date  DATE
  client_id        STRING [foreign_key: 'true']
  active_hours_sum FLOAT  [additive_type: 'additive']
  search_count_all INT    [additive_type: 'additive']
  country          STRING
  indexes {
    (submission_date, client_id) [pk]
  }
}

// ERD Studio relationships: Refs only, split across relationships/ files however you like. Every table a Ref names has a use line here.
use { table gold.dim_customer }   from '../tables/gold/dim_customer.dbml'
use { table gold.dim_date }       from '../tables/gold/dim_date.dbml'
use { table gold.dim_product }    from '../tables/gold/dim_product.dbml'
use { table gold.fct_order_line } from '../tables/gold/fct_order_line.dbml'

Ref: gold.fct_order_line.customer_key >? gold.dim_customer.customer_key
Ref: gold.fct_order_line.order_date_key >? gold.dim_date.date_key
Ref: gold.fct_order_line.product_key >? gold.dim_product.product_key

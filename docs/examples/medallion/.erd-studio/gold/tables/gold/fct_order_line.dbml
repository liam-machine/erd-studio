Table gold.fct_order_line [
  role: 'transaction-fact',
  grain: 'One row per order line',
  rationale_design: 'Built from silver order_lines joined to silver_orders.'
] {
  Note: 'Sales, at the finest grain.'

  order_line_id  BIGINT          [pk]
  order_date_key INT             [foreign_key: 'true']
  customer_key   BIGINT          [foreign_key: 'true']
  product_key    BIGINT          [foreign_key: 'true']
  order_id       BIGINT          [note: 'Degenerate dimension: the order number']
  quantity       INT             [additive_type: 'additive']
  net_amount     "DECIMAL(12,2)" [additive_type: 'additive', note: 'In AUD, excluding GST']
}

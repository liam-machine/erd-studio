Table business_vault.bridge_customer_policy [
  grain: 'One row per customer, policy and snapshot date',
  vault_type: 'bridge'
] {
  Note: 'Bridge table: the customer-policy pairs in force on each day, so marts join without walking the link.'

  customer_hk        BINARY [foreign_key: 'true']
  policy_hk          BINARY [foreign_key: 'true']
  customer_policy_hk BINARY [foreign_key: 'true']
  snapshot_date      DATE
  indexes {
    (customer_hk, policy_hk, snapshot_date) [pk]
  }
}

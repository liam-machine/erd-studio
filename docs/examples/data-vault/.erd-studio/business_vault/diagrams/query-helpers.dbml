Project "query-helpers" {
  Note: 'PIT and bridge tables and the computed risk score, drawn with the raw vault tables they point at.'
  erd_schema_version: '7'
  erd_layout: '''
    bridge_customer_policy 248 815
    hub_customer 1004 295
    hub_policy 1144 899
    link_customer_policy 696 810
    pit_customer 12 243
    sat_customer_crm 572 527
    sat_customer_policy_admin 572 12
    sat_customer_risk_score 572 270
  '''
}

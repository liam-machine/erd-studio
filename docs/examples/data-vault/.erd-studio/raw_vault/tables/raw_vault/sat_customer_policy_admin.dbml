Table raw_vault.sat_customer_policy_admin [vault_type: 'satellite'] {
  Note: 'Customer details from the policy administration system.'

  customer_hk   BINARY    [foreign_key: 'true']
  load_datetime TIMESTAMP [note: 'When the row was loaded']
  hashdiff      BINARY
  date_of_birth DATE
  postcode      STRING
  record_source STRING    [note: 'The system the row came from']
  indexes {
    (customer_hk, load_datetime) [pk]
  }
}

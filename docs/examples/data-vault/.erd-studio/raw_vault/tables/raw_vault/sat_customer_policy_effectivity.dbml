Table raw_vault.sat_customer_policy_effectivity [vault_type: 'effectivity-satellite'] {
  Note: 'When each customer-policy link started and ended.'

  customer_policy_hk BINARY    [foreign_key: 'true']
  load_datetime      TIMESTAMP [note: 'When the row was loaded']
  start_datetime     TIMESTAMP
  end_datetime       TIMESTAMP
  record_source      STRING    [note: 'The system the row came from']
  indexes {
    (customer_policy_hk, load_datetime) [pk]
  }
}

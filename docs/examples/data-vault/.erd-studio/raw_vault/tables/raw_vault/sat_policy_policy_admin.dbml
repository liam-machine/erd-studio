Table raw_vault.sat_policy_policy_admin [vault_type: 'satellite'] {
  Note: 'Policy details from the policy administration system.'

  policy_hk      BINARY    [foreign_key: 'true']
  load_datetime  TIMESTAMP [note: 'When the row was loaded']
  hashdiff       BINARY
  product_code   STRING
  start_date     DATE
  end_date       DATE
  annual_premium "DECIMAL(12,2)"
  record_source  STRING    [note: 'The system the row came from']
  indexes {
    (policy_hk, load_datetime) [pk]
  }
}

Table event.interaction_event [
  grain: 'One row per contact with a party',
  meta_owner: 'data-architecture'
] {
  Note: 'Every time a party contacted the bank: in a branch, on the phone or online.'

  interaction_id BIGINT [pk]
  party_id       BIGINT [foreign_key: 'true']
  channel        STRING [note: 'branch, call_centre, web, app']
  occurred_at    TIMESTAMP
  reason         STRING
}

// Landing has one schema per source system, so names carry the source too: every table name
// is unique across the whole project (core_customer, cards_account, …).
Table core_banking.core_customer [meta_owner: 'data-engineering'] {
  Note: 'Customers as the core banking system sends them.'

  customer_no   STRING    [pk, natural_key: 'true', note: 'The CIF number in core banking']
  full_name     STRING
  date_of_birth DATE
  customer_type STRING    [note: 'P = person, O = organisation']
  _loaded_at    TIMESTAMP [note: 'When the loader landed the row']
}

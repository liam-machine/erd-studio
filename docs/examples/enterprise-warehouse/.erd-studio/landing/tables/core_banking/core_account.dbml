Table core_banking.core_account [owner: 'data-engineering'] {
  Note: 'Accounts as the core banking system sends them.'

  account_no   STRING    [pk, natural_key: 'true']
  customer_no  STRING    [foreign_key: 'true', note: 'The account holder']
  product_code STRING
  branch_code  STRING
  opened_on    DATE
  status       STRING
  _loaded_at   TIMESTAMP [note: 'When the loader landed the row']
}

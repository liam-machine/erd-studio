Table inventory.fct_inventory_snapshot [
  role: 'periodic-snapshot',
  grain: 'One row per product per store per day',
  measures: 'Quantity on hand is semi-additive: add it across products and stores, never across days (take the last day of the period instead).'
] {
  Note: 'Stock on hand at the end of each day.'

  date_key         INT             [foreign_key: 'true']
  product_key      INT             [foreign_key: 'true']
  store_key        INT             [foreign_key: 'true']
  quantity_on_hand INT             [additive_type: 'semi-additive']
  inventory_value  "DECIMAL(12,2)" [additive_type: 'semi-additive', note: 'At cost']
  days_of_supply   "DECIMAL(8,2)"  [additive_type: 'non-additive']
  indexes {
    (date_key, product_key, store_key) [pk]
  }
}

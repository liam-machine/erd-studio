use { table sales.fct_retail_sales } from '../tables/sales/fct_retail_sales.dbml'
use { table conformed.dim_date }     from '../tables/conformed/dim_date.dbml'
use { table conformed.dim_product }  from '../tables/conformed/dim_product.dbml'
use { table conformed.dim_store }    from '../tables/conformed/dim_store.dbml'
use { table sales.dim_promotion }    from '../tables/sales/dim_promotion.dbml'
use * from '../relationships/sales.dbml'

Project "retail-sales" {
  Note: 'Retail sales star: the sales row of the bus matrix.'
  erd_schema_version: '7'
  erd_layout: '''
    dim_date 12 98
    dim_product 186 449
    dim_promotion 591 607
    dim_store 456 12
    fct_retail_sales 869 93
  '''
}

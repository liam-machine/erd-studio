# Source and build config (not needed at runtime)
.github/**
.vscode/**
.vscode-test/**
src/**
webview/**
out/**
out-webview/**
test/**
node_modules/**
.gitignore
.eslintrc.json
tsconfig.json
tsconfig.webview.json
esbuild.js
vitest.config.ts
scripts/**

# Documentation and planning (not needed at runtime).
# Root-level markdown is excluded wholesale; only the marketplace-facing
# README / CHANGELOG (and LICENSE) are re-included below.
docs/**
.planning/**
*.md
!README.md
!CHANGELOG.md
features.json

# Sibling projects that live in this repo but are not part of the extension.
# .vscodeignore is a DENYLIST — a new top-level directory ships unless it is
# named here, and CI fails if `vsce ls --no-dependencies` lists more than 60
# files. `proxy/` is the hand-deployed Cloudflare Worker behind the feedback
# analysis hosted tier (see proxy/README.md); it must never reach the VSIX.
forge-app/**
mcp-server/**
proxy/**
data engineer plugin/**

# Media referenced only by README.md. vsce rewrites the README's relative links
# to absolute github.com URLs when packaging, so a bundled copy is never read —
# it would just be dead weight in every install.
media/demo.gif
media/readme-workflow.png

# Dev/local files
.claude/**
.env*
dev-preview.html
.worktrees/**
*.vsix
# Scratch files the deploy workflow creates next to package.json
marketplace.json
vsce-show.err
vsce-files.txt
.DS_Store
**/.DS_Store

# dbt files (for testing only)
models/**
target/**
dbt_project.yml
selectors.yml

# Source maps and TypeScript (keep bundle small)
**/*.map
**/*.ts

# Re-include dist (but maps already excluded above)
!dist/*.js
!dist/*.css

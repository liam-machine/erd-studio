{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./out",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@erd-studio/core": ["./packages/core/src/index.ts"],
      "@erd-studio/renderer": ["./packages/renderer/src/index.ts"],
      "@erd-studio/renderer/editor": ["./packages/renderer/src/editor.ts"],
      "@erd-studio/renderer/store": ["./packages/renderer/src/store.ts"],
      "@erd-studio/renderer/sizing": ["./packages/renderer/src/sizing.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".vscode-test"]
}

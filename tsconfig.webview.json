{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "rootDir": ".",
    "outDir": "./out-webview",
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@erd-studio/core": ["./packages/core/src/index.ts"],
      "@erd-studio/renderer": ["./packages/renderer/src/index.ts"],
      "@erd-studio/renderer/editor": ["./packages/renderer/src/editor.ts"],
      "@erd-studio/renderer/store": ["./packages/renderer/src/store.ts"],
      "@erd-studio/renderer/sizing": ["./packages/renderer/src/sizing.ts"]
    }
  },
  "include": ["webview/**/*", "src/types/**/*"],
  "exclude": ["node_modules"]
}

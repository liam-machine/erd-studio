{
  // Local to proxy/ and deliberately NOT referenced by the root build.
  // `tsconfig.json` at the repo root includes only `src/**/*`, so nothing here
  // is ever compiled by `npm run compile`, `npm run build` or `npm test`.
  //
  // This exists so the Worker's JSDoc types can be checked (`npm run check`
  // in this directory) without adding a build step or a dependency: the file
  // that deploys is the file that is written, plain JavaScript, no bundling.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true
  },
  "include": ["src/**/*.js"]
}

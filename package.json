{
  "name": "dbt-semantic-designer",
  "displayName": "dbt Semantic Designer",
  "description": "Visualise semantic (FK-based) relationships between dbt models within curated business domains, with a design mode for planning new models, columns, and relationships.",
  "version": "0.1.7",
  "publisher": "liamwynne",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/liamwynne/dbt-semantic-designer"
  },
  "keywords": [
    "dbt",
    "semantic",
    "data modeling",
    "visualization",
    "ERD",
    "relationships"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dbtSemantic.createDomain",
        "title": "Create Semantic Domain",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.setupSemanticDirectory",
        "title": "Set Up Semantic Domains Directory",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.openDomain",
        "title": "Open Semantic Domain",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.deleteDomain",
        "title": "Delete Semantic Domain",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.refreshManifest",
        "title": "Refresh Manifest",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.syncDomainTags",
        "title": "Sync Domain Tags to Schema Files",
        "category": "dbt",
        "icon": "$(sync)"
      },
      {
        "command": "dbtSemantic.renameDomain",
        "title": "Rename Semantic Domain",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.addLayer",
        "title": "Add Layer",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.editLayer",
        "title": "Edit Layer",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.removeLayer",
        "title": "Remove Layer",
        "category": "dbt"
      },
      {
        "command": "dbtSemantic.initializeLayerConfig",
        "title": "Initialize Layer Configuration",
        "category": "dbt"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dbt-semantic",
          "title": "Semantic Domains",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dbt-semantic": [
        {
          "id": "dbtSemantic.domainTree",
          "name": "Domains"
        }
      ]
    },
    "colors": [
      {
        "id": "dbtSemantic.layer.bronze",
        "description": "Color for bronze layer folders",
        "defaults": {
          "dark": "#cd7f32",
          "light": "#cd7f32",
          "highContrast": "#cd7f32"
        }
      },
      {
        "id": "dbtSemantic.layer.silver",
        "description": "Color for silver layer folders",
        "defaults": {
          "dark": "#a0a0a0",
          "light": "#808080",
          "highContrast": "#a0a0a0"
        }
      },
      {
        "id": "dbtSemantic.layer.gold",
        "description": "Color for gold layer folders",
        "defaults": {
          "dark": "#d4a800",
          "light": "#b8960a",
          "highContrast": "#d4a800"
        }
      },
      {
        "id": "dbtSemantic.layer.platinum",
        "description": "Color for platinum layer folders",
        "defaults": {
          "dark": "#e5e4e2",
          "light": "#c0c0c0",
          "highContrast": "#e5e4e2"
        }
      },
      {
        "id": "dbtSemantic.layer.custom",
        "description": "Color for custom layer folders",
        "defaults": {
          "dark": "#6a9fb5",
          "light": "#4a7f95",
          "highContrast": "#6a9fb5"
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "dbtSemantic.domainTree",
        "contents": "No semantic domains found in this dbt project.\n\nSemantic domains help you visualize and design FK relationships between models, with built models shown in green and planned models in orange.\n\n[Get Started](command:dbtSemantic.setupSemanticDirectory)\n\nThis will create the directory structure and guide you to create your first domain."
      }
    ],
    "customEditors": [
      {
        "viewType": "dbtSemantic.domainEditor",
        "displayName": "Semantic Domain Editor",
        "selector": [
          {
            "filenamePattern": "**/models/semantic/**/*.json"
          }
        ],
        "priority": "default"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "dbtSemantic.renameDomain",
          "when": "view == dbtSemantic.domainTree && viewItem == domain",
          "group": "7_modification@1"
        },
        {
          "command": "dbtSemantic.deleteDomain",
          "when": "view == dbtSemantic.domainTree && viewItem == domain",
          "group": "7_modification@2"
        },
        {
          "command": "dbtSemantic.editLayer",
          "when": "view == dbtSemantic.domainTree && viewItem == layer",
          "group": "7_modification@1"
        },
        {
          "command": "dbtSemantic.removeLayer",
          "when": "view == dbtSemantic.domainTree && viewItem == layer",
          "group": "7_modification@2"
        }
      ],
      "view/title": [
        {
          "command": "dbtSemantic.syncDomainTags",
          "when": "view == dbtSemantic.domainTree",
          "group": "navigation@1"
        },
        {
          "command": "dbtSemantic.addLayer",
          "when": "view == dbtSemantic.domainTree",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "dbt Semantic Designer",
      "properties": {
        "dbtSemantic.projectPath": {
          "type": "string",
          "default": "",
          "description": "Path to dbt project root (auto-detected from workspace)"
        },
        "dbtSemantic.semanticDir": {
          "type": "string",
          "default": "models/semantic",
          "description": "Relative path to semantic domain files within the dbt project"
        },
        "dbtSemantic.autoReconcile": {
          "type": "boolean",
          "default": true,
          "description": "Automatically transition design models to built when detected in manifest"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "compile": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vscode-test"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react": "^16.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/stream-json": "^1.7.8",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@vscode-elements/elements": "^1.6.0",
    "@vscode-elements/react-elements": "^0.5.0",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.9.3",
    "js-yaml": "^4.1.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "stream-json": "^1.8.0",
    "zustand": "^5.0.0"
  }
}

{
  "name": "erd-studio",
  "displayName": "ERD Studio",
  "description": "Logical data modeling in Git: draw ERDs in VS Code as plain files your AI assistant can read. New projects are DBML, an open format; YAML/JSON projects keep working. Import from dbdiagram.io, compare with dbt.",
  "version": "1.7.2",
  "publisher": "liamwynne",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/liam-machine/erd-studio"
  },
  "homepage": "https://github.com/liam-machine/erd-studio#readme",
  "qna": "https://github.com/liam-machine/erd-studio/discussions",
  "galleryBanner": {
    "color": "#0e639c",
    "theme": "dark"
  },
  "pricing": "Free",
  "keywords": [
    "ERD",
    "DBML",
    "dbml editor",
    "dbdiagram",
    "logical data model",
    "data model",
    "data modeling",
    "data model as code",
    "entity relationship diagram",
    "erd diagram",
    "database diagram",
    "schema design",
    "database design",
    "dbt",
    "dbt-core",
    "dimensional modeling",
    "kimball",
    "star schema",
    "data warehouse",
    "medallion architecture",
    "analytics engineering",
    "snowflake",
    "databricks",
    "AI",
    "claude",
    "copilot",
    "MCP"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Data Science",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/dbt_project.yml",
    "workspaceContains:.erd-studio"
  ],
  "main": "./dist/extension.js",
  "workspaces": [
    "packages/*"
  ],
  "contributes": {
    "jsonValidation": [
      {
        "fileMatch": [
          "**/.erd-studio/*/*.json",
          "!**/.erd-studio/templates/*.json"
        ],
        "url": "./schemas/domain.schema.json"
      },
      {
        "fileMatch": "**/.erd-studio/layers.json",
        "url": "./schemas/layers.schema.json"
      },
      {
        "fileMatch": "**/.erd-studio/templates/*.json",
        "url": "./schemas/template.schema.json"
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          "**/.erd-studio/logical-models/*.yml",
          "**/.erd-studio/logical-models/*/*.yml",
          "**/.erd-studio/tables/*.yml",
          "**/.erd-studio/tables/*/*.yml"
        ],
        "url": "./schemas/logical-model.schema.json"
      }
    ],
    "commands": [
      {
        "command": "erdStudio.drawFromDbt",
        "title": "Draw from dbt…",
        "category": "ERD Studio",
        "icon": "$(wand)"
      },
      {
        "command": "erdStudio.importDbml",
        "title": "Import DBML…",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.openExampleDiagram",
        "title": "Open Example Diagram",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.exportDiagram",
        "title": "Export Diagram…",
        "category": "ERD Studio",
        "icon": "$(export)"
      },
      {
        "command": "erdStudio.exportAllDiagrams",
        "title": "Export All Diagrams…",
        "category": "ERD Studio",
        "icon": "$(export)"
      },
      {
        "command": "erdStudio.createDomain",
        "title": "New Diagram…",
        "category": "ERD Studio",
        "icon": "$(add)"
      },
      {
        "command": "erdStudio.setupSemanticDirectory",
        "title": "Set Up Subject Areas Directory",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.openDomain",
        "title": "Open Diagram",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.deleteDomain",
        "title": "Delete Diagram",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.refreshManifest",
        "title": "Refresh Manifest",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.renameDomain",
        "title": "Rename Diagram…",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.addLayer",
        "title": "New Layer…",
        "category": "ERD Studio",
        "icon": "$(new-folder)"
      },
      {
        "command": "erdStudio.editLayer",
        "title": "Edit Layer",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.removeLayer",
        "title": "Remove Layer",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.initializeLayerConfig",
        "title": "Initialize Layer Configuration",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.installCodingHarness",
        "title": "Install AI Helper Files…",
        "category": "ERD Studio",
        "icon": "$(hubot)"
      },
      {
        "command": "erdStudio.syncDomainTags",
        "title": "Regenerate dbt selectors.yml",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.stripLegacyDomainTags",
        "title": "Strip Legacy Domain Tags from dbt Model YAMLs",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.migrateToV5",
        "title": "Migrate Subject Areas to the Central Table Library",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.migrateToTableNaming",
        "title": "Migrate to the New File Naming",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.convertProjectToDbml",
        "title": "Convert Project to DBML",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.deleteLogicalModel",
        "title": "Delete Table",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.revealLogicalModel",
        "title": "Reveal in Explorer",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.organizeModelLibrary",
        "title": "Organise Table Library by Layer",
        "category": "ERD Studio",
        "icon": "$(list-tree)"
      },
      {
        "command": "erdStudio.moveRelationshipsToLibrary",
        "title": "Move Relationships to Table Library",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.resolveDuplicateModel",
        "title": "Give Duplicate Table Its Own Name…",
        "category": "ERD Studio",
        "icon": "$(wand)"
      },
      {
        "command": "erdStudio.moveTable",
        "title": "Move Table…",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.moveDiagram",
        "title": "Move Diagram to Layer…",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.openInDiagram",
        "title": "Open in Diagram…",
        "category": "ERD Studio",
        "icon": "$(open-preview)"
      },
      {
        "command": "erdStudio.openRelationshipSource",
        "title": "Open in File",
        "category": "ERD Studio",
        "icon": "$(go-to-file)"
      },
      {
        "command": "erdStudio.reportBug",
        "title": "Send Feedback",
        "category": "ERD Studio",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "erdStudio.showLogs",
        "title": "Show Logs",
        "category": "ERD Studio",
        "icon": "$(output)"
      },
      {
        "command": "erdStudio.showGettingStarted",
        "title": "Watch Getting Started Video",
        "category": "ERD Studio",
        "icon": "$(play-circle)"
      },
      {
        "command": "erdStudio.trySampleProject",
        "title": "Try the Sample Project",
        "category": "ERD Studio",
        "icon": "$(beaker)"
      },
      {
        "command": "erdStudio.setupAiHelper",
        "title": "Set Up My AI Helper",
        "category": "ERD Studio",
        "icon": "$(sparkle)"
      },
      {
        "command": "erdStudio.setFeedbackApiKey",
        "title": "Set Feedback API Key",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.clearFeedbackApiKey",
        "title": "Clear Feedback API Key",
        "category": "ERD Studio"
      },
      {
        "command": "erdStudio.refreshMyReports",
        "title": "Refresh My Reports",
        "category": "ERD Studio",
        "icon": "$(refresh)"
      },
      {
        "command": "erdStudio.selectDbtProject",
        "title": "Select dbt Project…",
        "category": "ERD Studio",
        "icon": "$(folder-library)"
      }
    ],
    "submenus": [
      {
        "id": "erdStudio.newMenu",
        "label": "New…",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "erd-studio",
          "title": "ERD Studio",
          "icon": "media/icon-sidebar.svg"
        }
      ]
    },
    "views": {
      "erd-studio": [
        {
          "id": "erdStudio.domainTree",
          "name": "Diagrams"
        },
        {
          "id": "erdStudio.modelLibrary",
          "name": "Table Library",
          "when": "erdStudio.hasLogicalModelsDir"
        },
        {
          "id": "erdStudio.relationships",
          "name": "Relationships",
          "when": "erdStudio.hasLogicalModelsDir"
        },
        {
          "id": "erdStudio.help",
          "name": "Help & Feedback",
          "when": "erdStudio.hasProject",
          "visibility": "collapsed"
        }
      ]
    },
    "colors": [
      {
        "id": "erdStudio.layer.bronze",
        "description": "Color for bronze layer folders",
        "defaults": {
          "dark": "#cd7f32",
          "light": "#cd7f32",
          "highContrast": "#cd7f32"
        }
      },
      {
        "id": "erdStudio.layer.silver",
        "description": "Color for silver layer folders",
        "defaults": {
          "dark": "#a0a0a0",
          "light": "#808080",
          "highContrast": "#a0a0a0"
        }
      },
      {
        "id": "erdStudio.layer.gold",
        "description": "Color for gold layer folders",
        "defaults": {
          "dark": "#d4a800",
          "light": "#b8960a",
          "highContrast": "#d4a800"
        }
      },
      {
        "id": "erdStudio.layer.platinum",
        "description": "Color for platinum layer folders",
        "defaults": {
          "dark": "#e5e4e2",
          "light": "#c0c0c0",
          "highContrast": "#e5e4e2"
        }
      },
      {
        "id": "erdStudio.layer.custom",
        "description": "Color for custom layer folders",
        "defaults": {
          "dark": "#6a9fb5",
          "light": "#4a7f95",
          "highContrast": "#6a9fb5"
        }
      }
    ],
    "viewsWelcome": [
      {
        "view": "erdStudio.domainTree",
        "contents": "Design your data model as DBML files in a Git repo: an open format, no lock-in.\n\n[Open Folder](command:workbench.action.files.openFolder)\n\nAny folder works. If it holds a dbt project, ERD Studio also shows what dbt built.",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "erdStudio.domainTree",
        "contents": "Loading diagrams…",
        "when": "erdStudio.hasProject && erdStudio.diagramsLoading"
      },
      {
        "view": "erdStudio.domainTree",
        "contents": "No diagrams yet.\n\n[New Diagram](command:erdStudio.createDomain)\n\nEach table is a file in .erd-studio/ you can commit, reviewed like code.\n\n[Import DBML](command:erdStudio.importDbml)\n\nFrom dbdiagram.io or any DBML tool. Export back to DBML any time — an open format, no lock-in.\n\nNew to data modelling? [Open Example Diagram](command:erdStudio.openExampleDiagram)\n\nUsing dbt? Open its folder to compare your design with what dbt built.\n\n[Get started](command:erdStudio.showGettingStarted)",
        "when": "erdStudio.hasProject && !erdStudio.hasDbtProject && !erdStudio.diagramsLoading"
      },
      {
        "view": "erdStudio.domainTree",
        "contents": "No diagrams yet.\n\n[Draw from dbt](command:erdStudio.drawFromDbt)\n\nDraws your dbt models and their relationships on a canvas. No AI needed.\n\nRather start blank? [New Diagram](command:erdStudio.createDomain)\n\nAlready have a DBML file, from dbdiagram.io or another tool? [Import DBML](command:erdStudio.importDbml) Export back to DBML or Mermaid any time — an open format, no lock-in.\n\n[Get started](command:erdStudio.showGettingStarted)\n\nA one-minute video: drawing your project, exploring it, and optionally adding keys and grain with your AI assistant.",
        "when": "erdStudio.hasDbtProject && !erdStudio.diagramsLoading"
      },
      {
        "view": "erdStudio.domainTree",
        "contents": "This workspace has more than one dbt project.\n\n[Select dbt Project](command:erdStudio.selectDbtProject)",
        "when": "erdStudio.hasDbtProject && erdStudio.hasMultipleDbtProjects"
      },
      {
        "view": "erdStudio.modelLibrary",
        "contents": "Loading tables…",
        "when": "erdStudio.tablesLoading"
      },
      {
        "view": "erdStudio.modelLibrary",
        "contents": "No tables yet.\n\nEach table is a file in .erd-studio/ you can commit.\n\nOpen a diagram and add a table on the canvas, or ask your AI assistant to add one: it shows here, ready to use in any diagram.",
        "when": "!erdStudio.tablesLoading"
      },
      {
        "view": "erdStudio.relationships",
        "contents": "No relationships yet.\n\nOpen a diagram and use + Add → New Relationship, or press and hold a column on the canvas and drag it onto a column of another table. Your AI assistant can add them too. Each relationship shows here under both of its tables."
      }
    ],
    "walkthroughs": [
      {
        "id": "erdStudio.getStarted",
        "title": "Get started with ERD Studio",
        "description": "Design your data model in Git — from scratch, from DBML or from dbt — then let your AI assistant fill in the detail.",
        "steps": [
          {
            "id": "watch",
            "title": "Watch the one-minute tour",
            "description": "A one-minute video: draw your dbt project with Draw from dbt, explore the diagram, and compare it with what dbt built. No AI needed.\n[Watch the video](command:erdStudio.showGettingStarted)",
            "when": "erdStudio.hasDbtProject",
            "media": {
              "svg": "media/walkthrough/watch.svg",
              "altText": "A video player showing a small ERD diagram."
            },
            "completionEvents": [
              "onCommand:erdStudio.showGettingStarted"
            ]
          },
          {
            "id": "openProject",
            "title": "Open the folder your data model lives in",
            "description": "Any folder works: ERD Studio keeps your design in .erd-studio/ next to your code. If the folder holds a dbt project, ERD Studio finds it by itself and also shows what dbt built.\n[Open Folder](command:workbench.action.files.openFolder)",
            "when": "workspaceFolderCount == 0",
            "media": {
              "svg": "media/walkthrough/open-project.svg",
              "altText": "A project file list with dbt_project.yml highlighted."
            },
            "completionEvents": [
              "onContext:erdStudio.hasProject"
            ]
          },
          {
            "id": "newDiagram",
            "title": "Draw your first data model — no dbt needed",
            "description": "Start a blank diagram and add tables on the canvas. Each table is a file in .erd-studio/ you can commit and review like code.\n[New Diagram](command:erdStudio.createDomain)\nNew to data modelling? Start from a small coffee-shop star schema instead.\n[Open Example Diagram](command:erdStudio.openExampleDiagram)",
            "when": "!erdStudio.hasDbtProject",
            "media": {
              "svg": "media/walkthrough/new-diagram.svg",
              "altText": "A new diagram with its first table, and the DBML files a new project keeps it in under .erd-studio."
            },
            "completionEvents": [
              "onCommand:erdStudio.createDomain",
              "onCommand:erdStudio.openExampleDiagram"
            ]
          },
          {
            "id": "draw",
            "title": "Draw your dbt project — no AI needed",
            "description": "Pick a folder of dbt models. ERD Studio copies their columns and relationship tests into a diagram you can edit, and lays it out for you.\n[Draw from dbt](command:erdStudio.drawFromDbt)",
            "when": "erdStudio.hasDbtProject",
            "media": {
              "svg": "media/walkthrough/draw.svg",
              "altText": "dbt models picked from a list and drawn as a diagram with relationships."
            },
            "completionEvents": [
              "onCommand:erdStudio.drawFromDbt"
            ]
          },
          {
            "id": "importDbml",
            "title": "Start from a DBML file",
            "description": "From dbdiagram.io or any DBML tool. Export back to DBML or Mermaid any time: an open format, no lock-in.\n[Import DBML…](command:erdStudio.importDbml)",
            "media": {
              "svg": "media/walkthrough/import-dbml.svg",
              "altText": "A DBML file turned into a diagram, with DBML and Mermaid export."
            },
            "completionEvents": [
              "onCommand:erdStudio.importDbml"
            ]
          },
          {
            "id": "enrich",
            "title": "Enrich it with your AI assistant",
            "description": "Add grain, keys, rationale and your team's modelling style. This installs a guide for Claude Code, GitHub Copilot, Codex, Gemini CLI or Cursor; then type /erd-studio-setup in your assistant.\n[Set Up My AI Helper](command:erdStudio.setupAiHelper)",
            "media": {
              "svg": "media/walkthrough/enrich.svg",
              "altText": "A table with key badges, typed columns and a grain note."
            },
            "completionEvents": [
              "onCommand:erdStudio.setupAiHelper"
            ]
          },
          {
            "id": "sample",
            "title": "Using dbt? Try the sample project",
            "description": "A small dbt project to compare a design with what dbt built.\n[Try the sample project](command:erdStudio.trySampleProject)",
            "when": "!erdStudio.hasDbtProject",
            "media": {
              "svg": "media/walkthrough/sample.svg",
              "altText": "A sample dbt project folder and the star schema diagram drawn from it."
            },
            "completionEvents": [
              "onCommand:erdStudio.trySampleProject"
            ]
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "erdStudio.domainEditor",
        "displayName": "ERD Studio Diagram",
        "selector": [
          {
            "filenamePattern": "**/.erd-studio/*/*.json"
          },
          {
            "filenamePattern": "**/erd-studio/*/*.json"
          },
          {
            "filenamePattern": "**/.erd-studio/*/diagrams/*.dbml"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "dbml",
        "aliases": [
          "DBML"
        ],
        "extensions": [
          ".dbml"
        ],
        "configuration": "./syntaxes/dbml.language-configuration.json"
      },
      {
        "id": "dbml-diagram",
        "aliases": [
          "DBML Diagram"
        ],
        "filenamePatterns": [
          "**/.erd-studio/*/diagrams/*.dbml"
        ],
        "configuration": "./syntaxes/dbml.language-configuration.json",
        "icon": {
          "light": "./media/file-icons/dbml-diagram-light.svg",
          "dark": "./media/file-icons/dbml-diagram-dark.svg"
        }
      },
      {
        "id": "dbml-table",
        "aliases": [
          "DBML Table"
        ],
        "filenamePatterns": [
          "**/.erd-studio/*/tables/*/*.dbml"
        ],
        "configuration": "./syntaxes/dbml.language-configuration.json",
        "icon": {
          "light": "./media/file-icons/dbml-table-light.svg",
          "dark": "./media/file-icons/dbml-table-dark.svg"
        }
      },
      {
        "id": "dbml-relationships",
        "aliases": [
          "DBML Relationships"
        ],
        "filenamePatterns": [
          "**/.erd-studio/*/relationships/*.dbml"
        ],
        "configuration": "./syntaxes/dbml.language-configuration.json",
        "icon": {
          "light": "./media/file-icons/dbml-relationships-light.svg",
          "dark": "./media/file-icons/dbml-relationships-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "dbml",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      },
      {
        "language": "dbml-diagram",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      },
      {
        "language": "dbml-table",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      },
      {
        "language": "dbml-relationships",
        "scopeName": "source.dbml",
        "path": "./syntaxes/dbml.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[dbml]": {
        "editor.defaultFormatter": "liamwynne.erd-studio",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[dbml-diagram]": {
        "editor.defaultFormatter": "liamwynne.erd-studio",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[dbml-table]": {
        "editor.defaultFormatter": "liamwynne.erd-studio",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      },
      "[dbml-relationships]": {
        "editor.defaultFormatter": "liamwynne.erd-studio",
        "editor.tabSize": 2,
        "editor.insertSpaces": true
      }
    },
    "menus": {
      "view/item/context": [
        {
          "command": "erdStudio.exportDiagram",
          "when": "view == erdStudio.domainTree && viewItem == domain",
          "group": "5_export@1"
        },
        {
          "command": "erdStudio.renameDomain",
          "when": "view == erdStudio.domainTree && viewItem == domain",
          "group": "7_modification@1"
        },
        {
          "command": "erdStudio.moveDiagram",
          "when": "view == erdStudio.domainTree && viewItem == domain && erdStudio.storage =~ /^(dbml|mixed)$/",
          "group": "7_modification@2"
        },
        {
          "command": "erdStudio.deleteDomain",
          "when": "view == erdStudio.domainTree && viewItem == domain",
          "group": "7_modification@3"
        },
        {
          "command": "erdStudio.createDomain",
          "when": "view == erdStudio.domainTree && viewItem == layerCreatable",
          "group": "inline"
        },
        {
          "command": "erdStudio.createDomain",
          "when": "view == erdStudio.domainTree && viewItem == layerCreatable",
          "group": "1_new@1"
        },
        {
          "command": "erdStudio.editLayer",
          "when": "view == erdStudio.domainTree && viewItem =~ /^layer/",
          "group": "7_modification@1"
        },
        {
          "command": "erdStudio.removeLayer",
          "when": "view == erdStudio.domainTree && viewItem =~ /^layer/",
          "group": "7_modification@2"
        },
        {
          "command": "erdStudio.openInDiagram",
          "when": "view == erdStudio.modelLibrary && viewItem == logicalModel",
          "group": "inline"
        },
        {
          "command": "erdStudio.openInDiagram",
          "when": "view == erdStudio.modelLibrary && viewItem =~ /^logicalModel(Duplicate|ReadOnly)?$/",
          "group": "navigation@0"
        },
        {
          "command": "erdStudio.revealLogicalModel",
          "when": "view == erdStudio.modelLibrary && viewItem =~ /^logicalModel(Duplicate)?$/",
          "group": "navigation@1"
        },
        {
          "command": "erdStudio.moveTable",
          "when": "view == erdStudio.modelLibrary && viewItem == logicalModel && erdStudio.storage =~ /^(dbml|mixed)$/",
          "group": "7_modification@0"
        },
        {
          "command": "erdStudio.deleteLogicalModel",
          "when": "view == erdStudio.modelLibrary && viewItem == logicalModel",
          "group": "7_modification@1"
        },
        {
          "command": "erdStudio.resolveDuplicateModel",
          "when": "view == erdStudio.modelLibrary && viewItem == logicalModelDuplicate",
          "group": "inline"
        },
        {
          "command": "erdStudio.resolveDuplicateModel",
          "when": "view == erdStudio.modelLibrary && viewItem == logicalModelDuplicate",
          "group": "7_modification@0"
        },
        {
          "command": "erdStudio.openInDiagram",
          "when": "view == erdStudio.relationships && viewItem == relationshipsTable",
          "group": "inline"
        },
        {
          "command": "erdStudio.openRelationshipSource",
          "when": "view == erdStudio.relationships && viewItem == relationship",
          "group": "inline"
        },
        {
          "command": "erdStudio.openInDiagram",
          "when": "view == erdStudio.relationships && viewItem =~ /^(relationship|relationshipsTable)$/",
          "group": "navigation@1"
        },
        {
          "command": "erdStudio.openRelationshipSource",
          "when": "view == erdStudio.relationships && viewItem == relationship",
          "group": "navigation@2"
        },
        {
          "command": "erdStudio.refreshMyReports",
          "when": "view == erdStudio.help && viewItem == myReports",
          "group": "inline"
        }
      ],
      "explorer/context": [
        {
          "command": "erdStudio.moveTable",
          "when": "resourceLangId == dbml-table && erdStudio.storage =~ /^(dbml|mixed)$/",
          "group": "7_modification@9"
        },
        {
          "command": "erdStudio.moveDiagram",
          "when": "resourceLangId == dbml-diagram && erdStudio.storage =~ /^(dbml|mixed)$/",
          "group": "7_modification@9"
        }
      ],
      "view/title": [
        {
          "submenu": "erdStudio.newMenu",
          "when": "view == erdStudio.domainTree && erdStudio.hasProject",
          "group": "navigation@0"
        },
        {
          "command": "erdStudio.selectDbtProject",
          "when": "view == erdStudio.domainTree && erdStudio.hasMultipleDbtProjects",
          "group": "1_project@1"
        },
        {
          "command": "erdStudio.exportAllDiagrams",
          "when": "view == erdStudio.domainTree && erdStudio.hasSemanticDir",
          "group": "2_export@1"
        },
        {
          "command": "erdStudio.organizeModelLibrary",
          "when": "view == erdStudio.modelLibrary",
          "group": "1_organise@0"
        },
        {
          "command": "erdStudio.moveRelationshipsToLibrary",
          "when": "view == erdStudio.modelLibrary && erdStudio.storage != dbml",
          "group": "1_organise@1"
        },
        {
          "command": "erdStudio.migrateToTableNaming",
          "when": "view == erdStudio.modelLibrary && erdStudio.storage == yaml",
          "group": "1_organise@2"
        },
        {
          "command": "erdStudio.convertProjectToDbml",
          "when": "view == erdStudio.modelLibrary && erdStudio.storage != dbml",
          "group": "1_organise@3"
        },
        {
          "command": "erdStudio.installCodingHarness",
          "when": "view == erdStudio.help && erdStudio.hasSemanticDir",
          "group": "1_ai@1"
        },
        {
          "command": "erdStudio.refreshMyReports",
          "when": "view == erdStudio.help && erdStudio.hasTrackedReports",
          "group": "2_reports@1"
        }
      ],
      "commandPalette": [
        {
          "command": "erdStudio.moveRelationshipsToLibrary",
          "when": "erdStudio.storage != dbml"
        },
        {
          "command": "erdStudio.migrateToV5",
          "when": "erdStudio.storage != dbml"
        },
        {
          "command": "erdStudio.migrateToTableNaming",
          "when": "erdStudio.storage == yaml"
        },
        {
          "command": "erdStudio.convertProjectToDbml",
          "when": "erdStudio.hasProject"
        },
        {
          "command": "erdStudio.importDbml",
          "when": "erdStudio.hasProject"
        },
        {
          "command": "erdStudio.drawFromDbt",
          "when": "erdStudio.hasDbtProject"
        },
        {
          "command": "erdStudio.syncDomainTags",
          "when": "erdStudio.hasDbtProject"
        },
        {
          "command": "erdStudio.selectDbtProject",
          "when": "erdStudio.hasDbtProject"
        },
        {
          "command": "erdStudio.refreshManifest",
          "when": "erdStudio.hasDbtProject"
        },
        {
          "command": "erdStudio.stripLegacyDomainTags",
          "when": "erdStudio.hasDbtProject"
        },
        {
          "command": "erdStudio.moveTable",
          "when": "erdStudio.storage =~ /^(dbml|mixed)$/"
        },
        {
          "command": "erdStudio.moveDiagram",
          "when": "erdStudio.storage =~ /^(dbml|mixed)$/"
        },
        {
          "command": "erdStudio.openInDiagram",
          "when": "false"
        },
        {
          "command": "erdStudio.openRelationshipSource",
          "when": "false"
        }
      ],
      "erdStudio.newMenu": [
        {
          "command": "erdStudio.createDomain",
          "when": "erdStudio.hasProject",
          "group": "1_diagram@1"
        },
        {
          "command": "erdStudio.drawFromDbt",
          "when": "erdStudio.hasDbtProject",
          "group": "1_diagram@2"
        },
        {
          "command": "erdStudio.importDbml",
          "when": "erdStudio.hasProject",
          "group": "1_diagram@3"
        },
        {
          "command": "erdStudio.addLayer",
          "when": "erdStudio.hasSemanticDir",
          "group": "2_layer@1"
        }
      ]
    },
    "configuration": {
      "title": "ERD Studio",
      "properties": {
        "erdStudio.projectPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Folder that holds your ERD Studio data (`erdStudio.semanticDir` is created inside it). Usually a dbt project root, and auto-detected from the workspace when empty — but any folder works, with or without `dbt_project.yml`; without one there is no dbt manifest to compare against. Absolute, or relative to a workspace folder. Changing this requires a window reload."
        },
        "erdStudio.semanticDir": {
          "type": "string",
          "default": ".erd-studio",
          "description": "Folder, relative to the project, that holds ERD Studio's tables and diagrams. Changing this requires a window reload."
        },
        "erdStudio.claudeSync.skipPermissions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "When **Execute with Claude** launches Claude Code to apply a sync plan, pass `--dangerously-skip-permissions` so it edits files without asking. Off by default: Claude Code prompts before each file change. The launch command is always shown for confirmation first."
        },
        "erdStudio.feedback.aiAssist": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "markdownDescription": "Let the Feedback dialog make **one** request to a language model to draft a title, pick bug vs feature, and check for duplicate issues. Only what you typed is sent — diagnostics, file paths and model names never are. Your own model is used where VS Code has one (VS Code asks for access itself, once); otherwise `#erdStudio.feedback.endpoint#`, or — if `#erdStudio.feedback.hostedFallback#` is on — a relay run by the extension author that forwards your description to a named third-party AI provider under the author's account. That last one always asks first and names both. Turn this off to make no request at all."
        },
        "erdStudio.feedback.provider": {
          "scope": "machine",
          "type": "string",
          "default": "vscode",
          "enum": [
            "auto",
            "vscode",
            "endpoint",
            "hosted"
          ],
          "enumItemLabels": [
            "Automatic",
            "Your editor's model (Copilot)",
            "Your own API endpoint",
            "ERD Studio service"
          ],
          "markdownEnumDescriptions": [
            "Your editor's language model first, then `#erdStudio.feedback.endpoint#`, then the ERD Studio service. The old default; still honoured, no longer offered in the dialog.",
            "Only your editor's own language model. Nothing is sent anywhere else; if this editor has none, the Feedback dialog simply shows no analysis.",
            "Only `#erdStudio.feedback.endpoint#`, with the key you stored via **ERD Studio: Set Feedback API Key**. Not offered in the dialog unless you have already picked it here.",
            "Only the small relay run by the extension author, which forwards your description to a third-party AI provider under the author's account. Pick this if you have Copilot but would rather not spend it on triaging feedback. Requires `#erdStudio.feedback.hostedFallback#` to be on, and asks before the first request."
          ],
          "markdownDescription": "Which model triages your feedback. The Feedback dialog offers two: your editor’s own model, or the ERD Studio service. Each pins one destination and does **not** fall through — if the one you pick is unavailable here, the dialog says so and offers the other rather than quietly sending your text somewhere you did not choose. `auto` (the old default, your own model first) and `endpoint` still work if you set them here, but the dialog no longer offers them."
        },
        "erdStudio.feedback.hostedFallback": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "markdownDescription": "As a last resort — when VS Code offers no language model and `#erdStudio.feedback.endpoint#` is empty — allow the Feedback dialog to send your description to a small relay run by the extension author, which forwards it to a third-party AI provider under the author's account and that provider's terms. You are always asked first — the prompt names the relay and the provider — and the request carries only what you typed. Turn this off to keep feedback analysis on your own model or endpoint only."
        },
        "erdStudio.feedback.endpoint": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "markdownDescription": "Base URL of an OpenAI-compatible chat-completions API for feedback analysis (e.g. `https://api.openai.com/v1`). Leave empty to use VS Code's built-in language model when one is available. The API key is stored in secret storage via **ERD Studio: Set Feedback API Key**, never in settings."
        },
        "erdStudio.feedback.model": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "markdownDescription": "Model id sent to `#erdStudio.feedback.endpoint#`, e.g. `gpt-4o-mini`."
        },
        "erdStudio.feedback.trackReports": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show a **My Reports** view listing issues you filed from ERD Studio, refreshed from GitHub every few hours. Requires you to be signed in to GitHub in VS Code; the view is hidden otherwise and you are never prompted to sign in."
        },
        "erdStudio.telemetry.enabled": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "tags": [
            "telemetry",
            "usesOnlineServices"
          ],
          "markdownDescription": "Send one anonymous usage heartbeat a day: which ERD Studio features were used and how often, bucketed project sizes and error counts — never names, paths, file contents or error messages. This setting can only turn telemetry **off**: VS Code's `#telemetry.telemetryLevel#` must also allow it, and nothing is sent when that is `off`. See [Telemetry](https://github.com/liam-machine/erd-studio#telemetry) for every field sent and how long it is kept."
        },
        "erdStudio.checkKnownFixes": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "tags": [
            "usesOnlineServices"
          ],
          "markdownDescription": "When ERD Studio hits an error that a newer release already fixes, say so and offer **Update**. The first error in a session downloads the list of known fixes (once a day at most) from ERD Studio's server; the request carries nothing about you, your project or the error — the list is matched on your machine. Works whether or not `#erdStudio.telemetry.enabled#` is on."
        },
        "erdStudio.dbml.offerConvert": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "When you open a diagram in a YAML/JSON project, offer once a session to convert it to DBML. Your project keeps working as it is either way; turn this off to stop the offer in every workspace. **ERD Studio: Convert Project to DBML** still works from the Command Palette."
        },
        "erdStudio.dbml.updateReferencesOnMove": {
          "type": "string",
          "enum": [
            "prompt",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask each time, with Update, Always and Never.",
            "Update the files that point at it without asking.",
            "Leave every file as it is, and ask nothing. A file moved where ERD Studio does not read it is still pointed out."
          ],
          "default": "prompt",
          "markdownDescription": "When you move or rename a `.dbml` file (or a folder of them) in the Explorer in a DBML project, update the diagrams and relationships files that point at it: their `use` lines, and the table's schema (`Table crm.fct_order`) when it lands in another schema folder. Renaming a table file renames the table everywhere, since its file name is its name. Each update is one step for **Edit > Undo**. **Move Table…** and **Move Diagram to Layer…** always update them, whatever this says."
        },
        "dbtSemantic.projectPath": {
          "type": "string",
          "markdownDeprecationMessage": "Deprecated: use `#erdStudio.projectPath#` instead. Legacy values are still honoured.",
          "description": "Path to dbt project root (auto-detected from workspace)"
        },
        "dbtSemantic.semanticDir": {
          "type": "string",
          "markdownDeprecationMessage": "Deprecated: use `#erdStudio.semanticDir#` instead. Legacy values are still honoured.",
          "description": "Folder, relative to the project, that holds ERD Studio's tables and diagrams"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "vscode:prepublish": "npm run package",
    "build:packages": "npm run build -w @erd-studio/core && npm run build -w @erd-studio/renderer",
    "compile": "tsc --noEmit && tsc --noEmit -p tsconfig.webview.json && npm run typecheck --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "regen-fixtures": "tsx scripts/regen-fixtures.ts",
    "test:e2e:dbml": "node scripts/e2e-dbml.mjs"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "1.85.0",
    "ajv": "^8.20.0",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "vscode-oniguruma": "2.0.1",
    "vscode-textmate": "9.3.2"
  },
  "dependencies": {
    "@dbml/parse": "11.0.0",
    "@erd-studio/core": "0.4.0",
    "@erd-studio/renderer": "0.4.0",
    "@xyflow/react": "^12.4.0",
    "elkjs": "^0.9.3",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.0"
  },
  "bugs": {
    "url": "https://github.com/liam-machine/erd-studio/issues"
  }
}

{
  "example": "dbt-project-layers",
  "layers": [
    {
      "id": "staging",
      "label": "Staging",
      "abbreviation": "STG"
    },
    {
      "id": "intermediate",
      "label": "Intermediate",
      "abbreviation": "INT"
    },
    {
      "id": "marts",
      "label": "Marts",
      "abbreviation": "MRT"
    }
  ],
  "tables": {
    "intermediate.int_invoices_allocated_to_months": {
      "layer": "intermediate",
      "schema": "intermediate",
      "grain": "One row per invoice per month it covers",
      "columns": [
        "invoice_id STRING pk fk",
        "revenue_month DATE pk",
        "customer_id STRING",
        "allocated_amount DECIMAL(12,2) additive"
      ]
    },
    "marts.customers": {
      "layer": "marts",
      "schema": "marts",
      "role": "conformed-dim",
      "grain": "One row per paying customer",
      "columns": [
        "customer_id STRING pk nk",
        "account_id STRING",
        "account_name STRING",
        "industry STRING",
        "plan_code STRING",
        "first_paid_at TIMESTAMP",
        "is_active BOOLEAN"
      ]
    },
    "marts.invoices": {
      "layer": "marts",
      "schema": "marts",
      "role": "transaction-fact",
      "grain": "One row per invoice",
      "columns": [
        "invoice_id STRING pk nk",
        "customer_id STRING fk",
        "invoiced_on DATE",
        "amount_due DECIMAL(12,2) additive",
        "amount_paid DECIMAL(12,2) additive",
        "is_paid BOOLEAN"
      ]
    },
    "marts.monthly_revenue": {
      "layer": "marts",
      "schema": "marts",
      "role": "periodic-snapshot",
      "grain": "One row per customer per month",
      "columns": [
        "customer_id STRING pk fk",
        "revenue_month DATE pk",
        "mrr DECIMAL(12,2) semi-additive",
        "is_new BOOLEAN",
        "is_churned BOOLEAN"
      ]
    },
    "marts.users": {
      "layer": "marts",
      "schema": "marts",
      "role": "domain-dim",
      "grain": "One row per user",
      "columns": [
        "user_id STRING pk nk",
        "customer_id STRING fk",
        "role STRING",
        "days_since_active INT",
        "is_power_user BOOLEAN"
      ]
    },
    "staging.stg_app__accounts": {
      "layer": "staging",
      "schema": "staging",
      "grain": "One row per account in the app",
      "columns": [
        "account_id STRING pk nk",
        "account_name STRING",
        "industry STRING",
        "signed_up_at TIMESTAMP"
      ]
    },
    "staging.stg_app__users": {
      "layer": "staging",
      "schema": "staging",
      "grain": "One row per user in the app",
      "columns": [
        "user_id STRING pk nk",
        "account_id STRING fk",
        "role STRING",
        "last_active_at TIMESTAMP"
      ]
    },
    "staging.stg_stripe__customers": {
      "layer": "staging",
      "schema": "staging",
      "grain": "One row per Stripe customer",
      "columns": [
        "customer_id STRING pk nk",
        "email STRING",
        "app_account_id STRING",
        "created_at TIMESTAMP"
      ]
    },
    "staging.stg_stripe__invoices": {
      "layer": "staging",
      "schema": "staging",
      "grain": "One row per Stripe invoice",
      "columns": [
        "invoice_id STRING pk nk",
        "subscription_id STRING fk",
        "amount_due DECIMAL(12,2)",
        "amount_paid DECIMAL(12,2)",
        "period_start DATE",
        "period_end DATE"
      ]
    },
    "staging.stg_stripe__subscriptions": {
      "layer": "staging",
      "schema": "staging",
      "grain": "One row per Stripe subscription",
      "columns": [
        "subscription_id STRING pk nk",
        "customer_id STRING fk",
        "plan_code STRING",
        "status STRING",
        "started_at TIMESTAMP",
        "cancelled_at TIMESTAMP"
      ]
    }
  },
  "diagrams": [
    {
      "file": "intermediate/diagrams/revenue.dbml",
      "name": "revenue",
      "layer": "intermediate",
      "tables": [
        "intermediate.int_invoices_allocated_to_months",
        "staging.stg_stripe__invoices"
      ],
      "relationships": [
        "int_invoices_allocated_to_months.invoice_id -> stg_stripe__invoices.invoice_id many-to-one"
      ]
    },
    {
      "file": "marts/diagrams/finance.dbml",
      "name": "finance",
      "layer": "marts",
      "tables": [
        "marts.customers",
        "marts.invoices",
        "marts.monthly_revenue"
      ],
      "relationships": [
        "invoices.customer_id -> customers.customer_id many-to-one",
        "monthly_revenue.customer_id -> customers.customer_id many-to-one"
      ]
    },
    {
      "file": "marts/diagrams/marketing.dbml",
      "name": "marketing",
      "layer": "marts",
      "tables": [
        "marts.customers",
        "marts.users"
      ],
      "relationships": [
        "users.customer_id -> customers.customer_id many-to-one"
      ]
    },
    {
      "file": "staging/diagrams/app.dbml",
      "name": "app",
      "layer": "staging",
      "tables": [
        "staging.stg_app__accounts",
        "staging.stg_app__users"
      ],
      "relationships": [
        "stg_app__users.account_id -> stg_app__accounts.account_id many-to-one"
      ]
    },
    {
      "file": "staging/diagrams/stripe.dbml",
      "name": "stripe",
      "layer": "staging",
      "tables": [
        "staging.stg_stripe__customers",
        "staging.stg_stripe__invoices",
        "staging.stg_stripe__subscriptions"
      ],
      "relationships": [
        "stg_stripe__invoices.subscription_id -> stg_stripe__subscriptions.subscription_id many-to-one",
        "stg_stripe__subscriptions.customer_id -> stg_stripe__customers.customer_id many-to-one"
      ]
    }
  ]
}

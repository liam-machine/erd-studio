Table silver.fct_sale [
  role: 'transaction-fact',
  grain: 'One row per sale transaction'
] {
  Note: 'Sales transaction fact table'

  sale_id     INT     [
    pk,
    natural_key: 'true',
    note: 'Sale id from the source system — a degenerate dimension, and this fact\'s own key'
  ]
  project_key INT     [foreign_key: 'true', note: 'FK to dim_project']
  amount      DECIMAL [additive_type: 'additive', note: 'Sale amount']
}

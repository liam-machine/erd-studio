Table silver.dim_project [
  role: 'conformed-dim',
  grain: 'One row per project',
  rationale_purpose: 'Central project reference shared across domains',
  rationale_design: 'Conformed dimension for consistent project attributes',
  rationale_scd_strategy: 'project_key is the surrogate facts join to; project_code is the business key'
] {
  Note: 'Project dimension table'

  project_key        INT     [
    pk,
    scd_type: '0',
    note: 'Surrogate key — warehouse-generated, one per row'
  ]
  project_code       VARCHAR [
    natural_key: 'true',
    scd_type: '0',
    note: 'Business project code from the source system'
  ]
  project_name       VARCHAR [scd_type: '1', note: 'Project name — not unique, so never a key']
  parent_project_key INT     [
    foreign_key: 'true',
    note: 'Parent project for hierarchical rollups (self-reference to project_key)'
  ]
}

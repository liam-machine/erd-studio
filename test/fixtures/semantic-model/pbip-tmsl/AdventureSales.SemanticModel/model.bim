          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Sql.Database(ServerName, \"AdventureWorksDW\"),",
                "    t = Source{[Schema=\"dbo\",Item=\"FactInternetSales\"]}[Data]",
                "in",
                "    t"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Sales",
            "description": "Revenue after discounts.",
            "expression": "SUM(Sales[Sales Amount])",
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
          },
          {
            "name": "Sales YoY %",
            "expression": [
              "",
              "VAR _cur = [Total Sales]",
              "VAR _prev = CALCULATE ( [Total Sales], SAMEPERIODLASTYEAR ( 'Date Table'[Date] ) )",
              "RETURN",
              "    DIVIDE ( _cur - _prev, _prev )"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Order Count",
            "expression": "DISTINCTCOUNT ( Sales[SalesOrderNumber] )",
            "formatString": "0"
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]

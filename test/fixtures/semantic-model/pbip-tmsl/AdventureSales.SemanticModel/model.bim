          {
            "name": "Sales Amount",
            "dataType": "decimal",
            "description": "Quantity × unit price, after the line discount.",
            "sourceColumn": "SalesAmount",
            "lineageTag": "00000000-0000-4000-8000-000000000010",
            "summarizeBy": "none"
          },
          {
            "name": "Line Margin",
            "dataType": "decimal",
            "type": "calculated",
            "description": "Margin on the line.",
            "expression": "Sales[Sales Amount] - RELATED ( 'Product'[Standard Cost] ) * Sales[Quantity]",
            "lineageTag": "00000000-0000-4000-8000-000000000011",
            "summarizeBy": "none"
          },
          {
            "name": "IsReturned",

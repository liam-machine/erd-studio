// erd-studio dbml-export v2 (DBML 9.1+)
// Canvas layout: sales.dbdiagram, next to this file (dbdiagram push reads it).
// A ? next to a Ref's operator: the end across from it may be null. ERD Studio does not record nullability.

Project sales {
  Note: 'Orders and the customers who place them'
}

Table gold.fct_order [
  role: 'transaction-fact',
  grain: 'One row per order line',
  alias: 'orders',
  rationale_purpose: 'Order reporting',
  rationale_scd_strategy: '''Facts are never
updated in place''',
  meta_owner: 'sales-team',
  meta_json: '{"tier":"1","pii":false,"tags":["finance","daily"],"Odd Key":null}'
] {
  order_id int [note: 'Order number', natural_key: 'true']
  line_no int
  customer_key int [foreign_key: 'true']
  ship_date_key int
  order_date_key int
  amount "decimal(18,2)" [additive_type: 'additive', meta_unit: 'AUD']
  discount decimal [additive_type: 'non-additive', meta_json: '{"nullable":true}']
  Note: 'Order lines'

  indexes {
    (order_id, line_no) [pk]
  }
}

Table gold.dim_customer [role: 'conformed-dim', grain: 'One row per customer version'] {
  customer_key int [pk]
  customer_id varchar [natural_key: 'true', scd_type: '0']
  segment varchar [scd_type: '2']
  passport_key int [unique]
  Note: 'Customers'
}

Table gold.dim_passport [role: 'reference'] {
  passport_key int [pk]
  country varchar [scd_type: '1']
}

Table gold.dim_date [role: 'conformed-dim'] {
  date_key int [pk]
  calendar_date date
}

Table gold.fct_shipment [role: 'transaction-fact'] {
  order_id int
  line_no int
  shipped_at timestamp
}

Table gold.empty_stub {
  _erd_no_columns unknown [erd_placeholder: 'true', note: 'ERD Studio: this table has no columns yet']
}

Table gold.bridge_tag [role: 'factless-fact'] {
  tag_id int [pk]
}

TableGroup gold [color: #f59e0b, note: 'Layer: Gold'] {
  gold.fct_order
  gold.dim_customer
  gold.dim_passport
  gold.dim_date
  gold.fct_shipment
  gold.empty_stub
  gold.bridge_tag
}

Ref: gold.fct_order.customer_key >? gold.dim_customer.customer_key
Ref "ship date": gold.fct_order.ship_date_key >? gold.dim_date.date_key
Ref "order date": gold.fct_order.order_date_key >? gold.dim_date.date_key
Ref: gold.dim_passport.passport_key ?- gold.dim_customer.passport_key
Ref: gold.fct_shipment.(order_id, line_no) >? gold.fct_order.(order_id, line_no)
Ref: gold.bridge_tag.tag_id <> gold.dim_customer.customer_key

Note sticky_1 [color: #3b82f6, linked_table: 'fct_order'] {
  'Check the grain with finance'
}

Note sticky_2 [color: #fef3c7] {
  '''Two
lines'''
}

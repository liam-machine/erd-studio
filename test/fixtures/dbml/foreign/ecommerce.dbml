// A foreign DBML file written from dbdiagram.io's public syntax docs
// (https://dbml.dbdiagram.io/docs): inline and block refs, composite refs,
// a table partial, an enum, optional refs, indexes, checks, defaults,
// settings ERD Studio has no field for, Records, and a project with a
// database type.

Project ecommerce {
  database_type: 'PostgreSQL'
  Note: 'Online shop: users, merchants, products and orders'
}

Enum order_status {
  created [note: 'Waiting to be processed']
  running
  done
  failure
}

TablePartial timestamps [headerColor: #3498DB] {
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp
  Note: 'Partial note'
}

Table users as U {
  id int [pk, increment]
  full_name varchar [not null]
  email varchar [unique, note: 'Login email']
  country_code int [ref: > countries.code, default: 61]
  age int [check: `age >= 0`]
  ~timestamps
  Note: 'Shop users'
}

Table countries {
  code int [pk]
  name varchar [not null]
  continent_name varchar
}

Table ecommerce.merchants {
  id int
  country_code int
  merchant_name varchar
  admin_id int [ref: > U.id]

  indexes {
    (id, country_code) [pk]
  }
}

Table ecommerce.products [headercolor: #79AD51] {
  id int [pk]
  name varchar
  merchant_id int [not null]
  country_code int
  price int [default: 0]
  status order_status [default: 'created']
  ~timestamps

  indexes {
    (merchant_id, status) [name: 'product_status']
    id [unique]
    `lower(name)` [type: hash]
  }
  checks {
    `price >= 0` [name: 'chk_price']
  }
}

Table orders {
  id int [pk]
  user_id int [not null]
  status order_status
  created_at varchar [note: 'When order created']
}

Table order_items {
  order_id int
  product_id int
  quantity int [default: 1]
}

Ref fk_merchant: ecommerce.products.(merchant_id, country_code) > ecommerce.merchants.(id, country_code) [delete: cascade, update: no action, color: #79AD51]
Ref: orders.user_id > users.id
Ref: order_items.order_id >? orders.id
Ref: order_items.product_id > ecommerce.products.id [inactive]

Records countries(code, name, continent_name) {
  61, 'Australia', 'Oceania'
  64, 'New Zealand', 'Oceania'
}

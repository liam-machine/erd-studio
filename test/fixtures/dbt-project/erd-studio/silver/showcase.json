            "dataType": "VARCHAR",
            "description": "Construction site name",
            "isNaturalKey": true
          },
          {
            "name": "latitude",
            "dataType": "FLOAT",
            "description": "GPS latitude"
          },
          {
            "name": "longitude",
            "dataType": "FLOAT",
            "description": "GPS longitude"
          }
        ],
        "rationale": {
          "purpose": "k"
        }
      }

  "logical": {
    "models": [
      {
        "name": "dim_project",
        "schema": "silver",
        "description": "Project dimension table",
        "grain": "One row per project",
        "modelRole": "conformed-dim",
        "rationale": {
          "purpose": "Central project reference shared across domains",
          "design": "Conformed dimension for consistent project attributes",
          "grainChoice": "Natural grain — each project is uniquely identified"
        },
        "columns": [
          {
            "name": "project_id",
            "dataType": "INT",
            "description": "Surrogate key for project",
            "isPrimaryKey": true
          },
          {
            "name": "project_name",
            "dataType": "VARCHAR",
            "description": "Project name"
          },
          {
            "name": "project_code",
            "dataType": "VARCHAR",
            "description": "Business project code — extra column not in physical (discrepancy)"
          },
          {
            "name": "region",
            "dataType": "VARCHAR",
            "description": "Geographic region — extra column not in physical",
            "isNaturalKey": true
          }
        ]
      },
      {
        "name": "dim_work_lot",
        "schema": "silver",
        "description": "Work lot dimension table",
        "grain": "One row per work lot",
        "modelRole": "domain-dim",
        "rationale": {
          "purpose": "Tracks individual work packages and their lifecycle",
          "design": "SCD Type 2 on status to track historical state changes",
          "scdStrategy": "Status changes tracked via SCD2; name is Type 1 overwrite"
        },
        "columns": [
          {
            "name": "work_lot_id",
            "dataType": "INT",
            "description": "Surrogate key for work lot",
            "isPrimaryKey": true
          },
          {
            "name": "project_id",
            "dataType": "INT",
            "description": "FK to dim_project",
            "isForeignKey": true
          },
          {
            "name": "name",
            "dataType": "VARCHAR",
            "description": "Work lot name",
            "scdType": 1
          },
          {
            "name": "status",
            "dataType": "STRING",
            "description": "Current status — type mismatch vs physical (STRING vs VARCHAR)",
            "scdType": 2
          },
          {
            "name": "priority",
            "dataType": "INT",
            "description": "Work lot priority level — extra column not in physical"
          }
        ]
      },
      {
        "name": "fct_work_events",
        "schema": "silver",
        "description": "Work events fact table — exists in logical and physical but missing from conceptual",
        "grain": "One row per work event",
        "modelRole": "transaction-fact",
        "rationale": {
          "purpose": "Records discrete work events against work lots",
          "measures": "Amount is fully additive across all dimensions"
        },
        "columns": [
          {
            "name": "event_id",
            "dataType": "INT",
            "description": "Event surrogate key",
            "isPrimaryKey": true
          },
          {
            "name": "work_lot_id",
            "dataType": "INT",
            "description": "FK to dim_work_lot",
            "isForeignKey": true
          },
          {
            "name": "event_date",
            "dataType": "DATE",
            "description": "Date of the event"
          },
          {
            "name": "amount",
            "dataType": "NUMERIC",
            "description": "Event amount",
            "additiveType": "additive"
          },
          {
            "name": "event_type",
            "dataType": "VARCHAR",
            "description": "Type of event — extra column not in physical"
          }
        ]
      },
      {
        "name": "dim_location",
        "schema": "silver",
        "description": "Location dimension — exists only in logical (missing from conceptual and physical)",
        "grain": "One row per location",
        "modelRole": "domain-dim",
        "columns": [
